# Long random string used to sign session cookies. Required in production.
SESSION_SECRET=change-me-to-a-long-random-string

# SQLite file (default ./data/gigkitchens.db). Use :memory: for throwaway environments.
# DATABASE_PATH=./data/gigkitchens.db

# Canonical site URL used in metadata.
SITE_URL=https://gigkitchens.com
