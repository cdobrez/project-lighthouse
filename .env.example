# Long random string used to sign session cookies. Required in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Hosted database (set automatically by the Turso integration on Vercel).
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=...

# Or any libSQL URL. Defaults to file:./data/gigkitchens.db when the disk is writable, else :memory:.
# DATABASE_URL=file:./data/gigkitchens.db

# Canonical site URL used in metadata.
SITE_URL=https://gigkitchens.com

# Photo uploads: Vercel Blob (set automatically by the connected Blob store on Vercel).
# Without it, photos are stored in ./data/uploads on hosts with a writable disk.
# BLOB_READ_WRITE_TOKEN=

# Payments: when set, checkout goes through hosted Stripe Checkout and orders wait for payment.
# Without it, checkout runs in demo mode (no card charged).
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (endpoint: /api/stripe/webhook, event: checkout.session.completed)

# Transactional email through Resend. Without it, emails are logged and skipped.
# RESEND_API_KEY=re_...
# EMAIL_FROM="Gig Kitchens <orders@gigkitchens.com>"

# Authorizes the daily standing-orders job (GET /api/cron/standing-orders with "Authorization: Bearer <secret>").
# Vercel Cron sends this automatically when CRON_SECRET is set on the project.
# CRON_SECRET=
